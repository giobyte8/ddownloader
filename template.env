
APP_ENV=dev
APP_PORT=5002

# Base URL for the web app, used to create links referencing
# the app itself (e.g., in notifications).
APP_BASE_URL=http://localhost:5002

GALLERIES_PATH=data/
CONFIG_PATH=config/

LOG_LEVEL=INFO

#################################################
# API Keys
# > python scripts/gen_api_key.py
#
#  NOTE: Placed here to avoid hard-coding into app code.
#    As it scales to support multiple clients/users, keys
#    persistence should be moved into different storage.

API_KEY_HOOKS=


#################################################
# Web UI authentication
#
#  Single shared admin account protecting the browser-facing pages
#  (e.g. /sources). The process refuses to start if any of these
#  are missing.
#
#  Generate SECRET_KEY with:
#    > python scripts/gen_api_key.py
#  Generate WEB_AUTH_PASSWORD_HASH with:
#    > python scripts/gen_password_hash.py <your-password>

SECRET_KEY=
WEB_AUTH_USERNAME=
WEB_AUTH_PASSWORD_HASH=

# How long a login session stays valid, in days.
SESSION_LIFETIME_DAYS=7


#################################################
# PostgreSQL Database Configuration

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ddownloader
DB_USERNAME=
DB_PASSWORD=

#################################################
# Communication to Central for monitoring

CT_MONITORING_ENABLED=false
CT_API_URL=http://localhost:5001/api
CT_API_KEY=


#################################################
# OpenTelemetry Configuration

OTEL_ENABLED=false
OTEL_SERVICE_NAME=ddownloader
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp,console
OTEL_EXPORTER_OTLP_ENDPOINT=0.0.0.0:4317
OTEL_EXPORTER_OTLP_INSECURE=true
